# Gemini API key for Real LLM calls
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODE=mock
REAL_LLM_PROVIDER=groq
REAL_LLM_MODEL=openai/gpt-oss-20b

# Groq API settings (for primary provider)
GROQ_API_KEY=your-groq-api-key-here

# OpenRouter API settings (for secondary provider / fallback)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.8-flash

# OpenAI API key (legacy / optional)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Hugging Face token for model/dataset access and remote storage
HF_TOKEN=hf_your-huggingface-token-here

# Environment Type (development/production/testing)
ENVIRONMENT=development
