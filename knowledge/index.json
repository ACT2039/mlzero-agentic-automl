rors=\"coerce\")\n         if s_num.notna().sum() / len(train", "source": "autogluon_tabular\\data_cleaning_and_types.md", "source_path": "knowledge\\autogluon_tabular\\data_cleaning_and_types.md", "library_name": "autogluon.tabular", "library_version": null, "summary": "Mock summary of documentation.", "condensed_guidance": "Mock condensed implementation guidance.", "tags": ["autogluon.tabular", "data_cleaning_and_types"], "metadata": {"start_char": 0, "end_char": 1000, "title": "Data Cleaning And Types"}, "embedding_metadata": {"summary": 0.02054794520547945, "mock": 0.02054794520547945, "of": 0.02054794520547945, "documentation": 0.0136986301369863, "original": 0.00684931506849315, "autogluon": 0.02054794520547945, "tabular": 0.0136986301369863, "data": 0.0136986301369863, "quality": 0.0136986301369863, "non": 0.00684931506849315, "numeric": 0.04794520547945205, "values": 0.0547945205479452, "and": 0.02054794520547945, "preprocessing": 0.0136986301369863, "handles": 0.00684931506849315, "many": 0.00684931506849315, "types": 0.00684931506849315, "missing": 0.0136986301369863, "automatically": 0.00684931506849315, "but": 0.00684931506849315, "malformed": 0.0136986301369863, "targets": 0.00684931506849315, "or": 0.0273972602739726, "dirty": 0.00684931506849315, "columns": 0.0136986301369863, "with": 0.02054794520547945, "unexpected": 0.00684931506849315, "string": 0.00684931506849315, "require": 0.00684931506849315, "common": 0.00684931506849315, "issues": 0.00684931506849315, "1": 0.00684931506849315, "target": 0.0273972602739726, "if": 0.02054794520547945, "contain": 0.0136986301369863, "strings": 0.00684931506849315, "like": 0.0136986301369863, "not_available": 0.00684931506849315, "unknown": 0.00684931506849315, "none": 0.00684931506849315, "in": 0.0136986301369863, "a": 0.00684931506849315, "regression": 0.00684931506849315, "task": 0.00684931506849315, "conversion": 0.00684931506849315, "will": 0.00684931506849315, "fail": 0.00684931506849315, "fix": 0.0136986